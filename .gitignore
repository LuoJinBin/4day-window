# 依赖
node_modules/

# 本地配置与密钥（绝不提交）
.env
.env.*
!.env.example
*.pem
*.key
cookies.txt

# 运行缓存与日志
data/cache/
*.log
logs/

# 系统与编辑器
.DS_Store
Thumbs.db
