{
  "name": "guangzhou-4day-window",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "全球城市自由出行天气规划：城市搜索、日期范围、逐小时天气与出行时段推荐",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
