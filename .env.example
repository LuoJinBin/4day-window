# 复制为 .env 后按需修改；全部可缺省，当前不需要任何密钥。
# 服务监听
PORT=8787
HOST=0.0.0.0

# 缓存与刷新（分钟）
CACHE_TTL_MINUTES=360
REFRESH_INTERVAL_MINUTES=360
CACHE_FILE=data/cache/forecast.json

# 数据源（可指向自建代理，参数保持不变）
OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast
# 四点：荔湾,越秀,天河,海珠
FORECAST_POINTS=23.125,113.24;23.129,113.267;23.135,113.33;23.09,113.31
FORECAST_DAYS=16
REQUEST_TIMEOUT_MS=14000

# 是否允许 /api/forecast?force=1 跳过缓存（默认关闭）
ALLOW_FORCE_REFRESH=false
